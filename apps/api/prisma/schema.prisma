generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  businessName  String
  sector        String
  features      String   @db.LongText
  blocks        Json
  globalPalette Json
  logoUrl       String?  @db.Text
  customRequest String?  @db.Text
  accessToken   String   @unique @default(uuid())
  status        String   @default("NEW")
  adminNotes    String?  @db.Text
  estimatedPrice Int?
  finalPrice    Int?
  businessProfile Json?
  ownerEmail    String?
  demoExpiresAt DateTime?
  quoteRequestedAt DateTime?
  publishedUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("projects")
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("email_verifications")
}

model UsageCounter {
  id          String   @id @default(cuid())
  scopeKey    String
  action      String
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@unique([scopeKey, action])
  @@map("usage_counters")
}

model Lead {
  id           String   @id @default(cuid())
  businessName String
  email        String
  whatsapp     String?
  sector       String
  createdAt    DateTime @default(now())

  @@map("leads")
}
